# =============================================================================
# Activity AI Keyrus — Backend Environment Configuration Template
# Copy this file to .env and fill in your actual values.
# NEVER commit .env with real credentials or secrets to Git.
# =============================================================================

# Server Port
PORT=8787

# Supabase Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# Mistral AI Configuration
MISTRAL_API_KEY=your-mistral-api-key
MISTRAL_MODEL=mistral-small-latest

# Azure DevOps Integration (Optional WorkItem link generation)
ADO_BASE_URL=https://scp-tma-flux.visualstudio.com
ADO_PROJECT_NAME=Gestion des tickets

# Project Manager Allowed Emails (comma-separated)
PM_ALLOWED_EMAILS=prenom.nom@keyrus.com

# =============================================================================
# Microsoft Entra ID (Azure AD) & Microsoft Graph Configuration (POC V2)
# Provided by Keyrus IT upon App Registration creation
# =============================================================================

# Client (Application) ID registered in Microsoft Entra ID
AZURE_CLIENT_ID=

# Directory (Tenant) ID (or 'organizations' / 'common' if multi-tenant)
AZURE_TENANT_ID=

# Client Secret (Only required for confidential client web server flows)
AZURE_CLIENT_SECRET=

# OAuth 2.0 Redirect URI (must match the Redirect URI registered in Entra ID)
AZURE_REDIRECT_URI=http://localhost:8787/api/poc/ms/callback

# Frontend Origin for OAuth redirect handling
FRONTEND_ORIGIN=http://localhost:5173
